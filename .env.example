# Cấu hình môi trường cho NEO API FinTech (VPBankS)
# LƯU Ý BẢO MẬT: Tuyệt đối không commit file .env chứa thông tin thật lên Git / Báo cáo công khai!

# 1. Chế độ vận hành
# LIVE: Kết nối trực tiếp đến NEO API thật
# MOCK: Sử dụng dữ liệu giả lập/mẫu để test và chấm bài offline
APP_ENV=MOCK

# 2. Cấu hình NEO API (VPBankS)
NEO_API_BASE_URL=https://neoinvest.vpbanks.com.vn/neo-openapi
NEO_WS_URL=wss://neoinvest.vpbanks.com.vn/neo-openapi/v1/stream
NEO_CONSUMER_KEY=your_consumer_key_here
NEO_CONSUMER_SECRET=your_consumer_secret_here
NEO_ACCESS_TOKEN=your_jwt_access_token_here

# 3. Cấu hình SSI FastConnect API (Tùy chọn bổ sung theo đề bài)
SSI_CONSUMER_ID=your_ssi_consumer_id
SSI_CONSUMER_SECRET=your_ssi_consumer_secret

# 4. Giới hạn tần suất và múi giờ
RATE_LIMIT_RPS=5
TIMEZONE=Asia/Ho_Chi_Minh
