# ==============================================================================
# NEO API CONFIGURATION (.env)
# Lưu ý: Tuyệt đối không commit file này lên GitHub hoặc chia sẻ công khai!
# Hãy tạo bản sao từ .env.example và điền thông tin tài khoản thật nếu có.
# ==============================================================================

# 1. VPBankS NeoAPI credentials (điền trong .env cục bộ; không commit .env)
NEO_USERNAME=your_vpbanks_login_username
NEO_PASSWORD=your_vpbanks_login_password
NEO_ACCOUNT_NO=your_account_no_here
NEO_WHITELIST_IP=your_registered_private_ip

# Chỉ dùng LIVE khi đã được VPBankS cấp quyền; để kiểm thử đặt UAT và URL tương ứng
NEO_ENVIRONMENT=LIVE
NEO_API_BASE_URL=https://neoapi.vpbanks.com.vn/neo-api
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_DEVICE=neoapi-fintech-dashboard
NEO_DEVICE_TYPE=chrome
NEO_REQUEST_TIMEOUT=15

# Giới hạn tần suất gọi API (tối đa 5 requests/giây)
NEO_RATE_LIMIT_RPS=5.0

# 2. Supplementary Data Source: SSI FastConnect API (Kênh bổ sung được ủy quyền)
SSI_FASTCONNECT_URL=https://api.ssi.com.vn
SSI_IBOARD_URL=https://iboard-query.ssi.com.vn
SSI_API_KEY=
SSI_API_SECRET=
SSI_PRIVATE_KEY=

# 3. Ứng dụng
APP_ENV=development
APP_PORT=8501
DATA_CACHE_DIR=./data_sample
DEFAULT_UNIVERSE=ALL
