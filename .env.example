# ==============================================================================
# NEO API CONFIGURATION (.env)
# Lưu ý: Tuyệt đối không commit file này lên GitHub hoặc chia sẻ công khai!
# Hãy tạo bản sao từ .env.example và điền thông tin tài khoản thật nếu có.
# ==============================================================================

# 1. VPBankS NEO API Credentials
NEO_CONSUMER_KEY=your_neo_consumer_key_here
NEO_CONSUMER_SECRET=your_neo_consumer_secret_here
NEO_ACCOUNT_NO=your_account_no_here

# Môi trường kết nối: LIVE hoặc MOCK (để chạy thử nghiệm khi chưa có API key thật)
NEO_ENVIRONMENT=MOCK
NEO_API_BASE_URL=https://neoinvest.vpbanks.com.vn/neo-openapi
NEO_WS_URL=wss://neoinvest.vpbanks.com.vn/neo-openapi/streaming

# Giới hạn tần suất gọi API (NEO API quy định tối đa 5 requests/giây)
NEO_RATE_LIMIT_RPS=5.0

# 2. SSI FastConnect API (Tùy chọn bổ trợ theo đề bài)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_PRIVATE_KEY_PATH=

# 3. Ứng dụng & Dữ liệu
APP_ENV=development
APP_PORT=8501
DATA_CACHE_DIR=./data_sample
DEFAULT_UNIVERSE=VN30
